# ==============================================================================
# Environment Configuration - Industrial HVAC Monitoring Platform (ThingsBoard)
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=thingsboard
POSTGRES_USER=thingsboard
POSTGRES_PASSWORD=thingsboard_secure_password_2026
POSTGRES_PORT=5432

# ThingsBoard Server Configuration
TB_HTTP_PORT=9090
TB_MQTT_PORT=1883
TB_COAP_PORT=5683

# Default Tenant Credentials (for automated provisioning)
TB_API_URL=http://localhost:9090
TB_TENANT_USERNAME=tenant@thingsboard.org
TB_TENANT_PASSWORD=tenant

# HVAC Device Credentials
HVAC_DEVICE_NAME=HVAC-01
HVAC_DEVICE_TOKEN=HVAC_VENT_SECRET_TOKEN
HVAC_DEVICE_MANUFACTURER=ORIONMETER
HVAC_DEVICE_MODEL=HVAC-VENT-001

# HVAC Simulator Engine Settings
SIMULATION_MODE=NORMAL
SIMULATION_INTERVAL=5.0
FILTER_SPEED=0.015
HTTP_PORT=8080
LOG_LEVEL=INFO
